# MangaID Configuration

# Gemini API Configuration (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_VISION=gemini-2.5-flash
GEMINI_MODEL_TEXT=gemini-2.5-flash
GEMINI_MODEL_IMAGE=gemini-2.5-flash
GEMINI_RPM=15
GEMINI_RPD=1500

# Application Settings
DATA_DIR=data
DATABASE_URL=sqlite:///./data/mangaid.db
LOG_LEVEL=INFO
MAX_PAGES_PER_JOB=100
HOST=127.0.0.1
PORT=8000
